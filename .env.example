# Copy to .env.local. Never commit real credentials.

# OpenAI (required when extraction/agent work is enabled)
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
OPENAI_EXTRACTION_MODEL=

# Supabase project settings (publishable key is safe for browser use with RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only admin key. Required only for demo-user provisioning/reset.
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true

# Dedicated pre-confirmed demo login; provision with pnpm demo:user.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Optional voice
SARVAM_API_KEY=
